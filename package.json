{
  "name": "xmdb",
  "version": "2.0.0",
  "private": true,
  "author": "Xyrus Code",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsdown src/main.tsx --format esm --out-dir build",
    "build:client": "tsdown src/main.tsx --format esm --out-dir build/client",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run version && npm run build && npm publish --access public && git push --follow-tags",
    "preview:pr": "pkg-pr-new",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource/dm-mono": "^5.2.7",
    "@tanstack/highlight": "^1.2.12",
    "@tanstack/pacer": "^0.23.1",
    "@tanstack/react-devtools": "^0.10.15",
    "@tanstack/react-hotkeys": "^0.27.2",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-store": "^0.11.4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28",
    "@tanstack/store": "^0.11.3",
    "@tanstack/table-core": "^9.3.1",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.18.1",
    "changesets": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "pkg-pr-new": "^0.0.94",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tsdown": "^0.23.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^28.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.22",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "Browse popular films and search The Movie Database. A contact sheet for the movies.",
  "license": "MIT"
}
