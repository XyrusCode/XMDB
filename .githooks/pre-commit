#!/bin/sh
# Fast feedback on staged files only. CI is the real gate — this is not it.
set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)
[ -z "$STAGED" ] && exit 0

echo "$STAGED" | xargs npx prettier --check
echo "$STAGED" | xargs npx eslint --max-warnings 0
